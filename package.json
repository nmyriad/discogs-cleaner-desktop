{
  "name": "discogs-cleaner",
  "version": "1.5.3",
  "description": "Rename music library folders using Discogs metadata",
  "main": "main.js",
  "author": "nmyriad",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder build --win",
    "pack": "electron-builder --dir"
  },
  "dependencies": {
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.nmyriad.discogs-cleaner",
    "productName": "discogs-cleaner",
    "publish": [
      {
        "provider": "github",
        "owner": "nmyriad",
        "repo": "discogs-cleaner-desktop"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico",
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico"
    },
    "extraResources": [
      {
        "from": "python/server.exe",
        "to": "python/server.exe"
      },
      {
        "from": "discogs-cleaner/index.html",
        "to": "app/index.html"
      }
    ],
    "files": [
      "main.js",
      "preload.js",
      "assets/**/*"
    ]
  }
}